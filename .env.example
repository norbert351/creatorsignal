# CreatorSignal backend configuration.
# Everything is CREATORSIGNAL_ prefixed so shared hosts cannot leak env vars in.

# Server
CREATORSIGNAL_PORT=3500
CREATORSIGNAL_LOG_LEVEL=info
CREATORSIGNAL_DB_PATH=./data/creatorsignal.sqlite
# Locks all /api/* routes behind this token (health + viewer stay public).
# The viewer asks for it once on first visit and remembers it.
# CREATORSIGNAL_API_TOKEN=

# Mind: simulated (dev/demo, detection runs locally) or telegram (real Mind).
CREATORSIGNAL_MIND_MODE=simulated
# Optional env fallback for the Telegram push (only when MIND_MODE=telegram).
# In the default demo the creator connects their bot + group from the web
# viewer onboarding ("Telegram push" card) — no env needed.
# CREATORSIGNAL_TELEGRAM_BOT_TOKEN=
# CREATORSIGNAL_TELEGRAM_GROUP_ID=

# Ingestion: either a channel id (resolved via uploads playlist) or video ids.
# CREATORSIGNAL_YOUTUBE_API_KEY=
# CREATORSIGNAL_YOUTUBE_CHANNEL_ID=
# CREATORSIGNAL_YOUTUBE_VIDEO_IDS=
CREATORSIGNAL_INGEST_DAYS_BACK=30
CREATORSIGNAL_INGEST_INTERVAL_MIN=30

# Distiller: OpenAI-compatible endpoint. Without a key the deterministic
# fallback classifier is used, so the pipeline runs fully offline.
# CREATORSIGNAL_LLM_API_KEY=
CREATORSIGNAL_LLM_BASE_URL=https://api.openai.com/v1
CREATORSIGNAL_LLM_MODEL=gpt-4o-mini

# Detection tuning
CREATORSIGNAL_MIN_DEMAND_SCORE=25
CREATORSIGNAL_SUPERFAN_THRESHOLD=30

# Daily digest, server local time HH:MM
CREATORSIGNAL_DIGEST_TIME=09:00

# Weekly content brief: day of week (0=Sun..6=Sat) + time, server local.
# The Mind drafts "make this next" with evidence and pushes it to Telegram
# when a bot is connected (web onboarding). Also available on demand in the
# viewer ("Generate now").
CREATORSIGNAL_BRIEF_DAY=1
CREATORSIGNAL_BRIEF_TIME=09:00
